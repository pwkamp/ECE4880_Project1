# One configuration file for backend/compose.yaml and both run scripts.
# These credentials are for loopback-only local integration, not production.
COMPOSE_PROJECT_NAME=ece4880-integration

# schema.sql currently owns this database name; keep it as thermometer.
MYSQL_DATABASE=thermometer
MYSQL_USER=thermo
# This value is embedded in MYSQL_URL for the Node reader; use URL-safe characters.
MYSQL_PASSWORD=thermometer-dev
MYSQL_ROOT_PASSWORD=thermometer-root-dev
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306

BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_PROXY_TARGET=http://backend:8000
FRONTEND_SERVER_PROXY_TARGET=http://127.0.0.1:8787

# Email delivery. Keep console for ordinary development. For the SYS-05 live
# Gmail check use EMAIL_MODE=live, your Gmail address, and a Google app
# password (never your normal account password). backend/.env is gitignored.
EMAIL_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_API_TOKEN=

# The Windows launchers map these values to the browser and native backend.
# Linux leaves VITE_BLE_API_BASE and CORS unset and uses the Vite proxy instead.
WINDOWS_BLE_API_BASE=http://127.0.0.1:8000/api/v1/ble
WINDOWS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
