{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-result.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "profile", "started_at_utc", "git_state", "requirements_catalog_sha256", "test_catalog_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["software", "integration", "hil", "full"]},
    "outcome": {"enum": ["PASS", "FAIL", "BLOCKED"]}
  },
  "additionalProperties": true
}
