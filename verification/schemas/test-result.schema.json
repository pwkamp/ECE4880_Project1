{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-result.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "test_id", "outcome", "requirements", "fixtures", "instrumentation", "started_at_utc", "duration_ms", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "outcome": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "NOT_APPLICABLE"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
