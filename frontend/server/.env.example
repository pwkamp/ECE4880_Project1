# console | test | live   (default: console)
EMAIL_MODE=console
PORT=8787

# Required for EMAIL_MODE=test or live. Gmail SMTP works from localhost.
# Use an App Password, not your normal Gmail password:
#   Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. If set, the frontend must send it as VITE_ALERT_API_TOKEN.
# NOTE: this is compiled into the client bundle, so it is NOT a real secret.
# The service binding to 127.0.0.1 is the actual access control.
ALERT_API_TOKEN=

# Optional MySQL URL for reading temperature_samples (feat/db-schema).
# In BLE mode, configure this so the graph/readouts use MySQL samples.
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/thermometer
MYSQL_URL=
