# Vite (frontend/). Restart `npm run dev` after changing this file.
#
# ble   = Python connector on 127.0.0.1:8000 + MySQL reader (default)
# mock  = explicit in-browser UI-only simulator
VITE_DATA_SOURCE=ble

# Optional. Leave unset for the Vite /api/v1 proxy. Native Windows integration
# uses http://127.0.0.1:8000/api/v1/ble through backend/.env instead.
# VITE_BLE_API_BASE=http://127.0.0.1:8000/api/v1/ble

# Optional. Must match ALERT_API_TOKEN in server/.env if that is set.
# VITE_ALERT_API_TOKEN=
