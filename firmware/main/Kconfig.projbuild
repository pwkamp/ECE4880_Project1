menu "Thermometer Configuration"
    choice THERMOMETER_SENSOR_BACKEND
        prompt "Temperature sensor backend"
        default THERMOMETER_SENSOR_BACKEND_REAL

        config THERMOMETER_SENSOR_BACKEND_FAKE
            bool "Deterministic simulated sensors"

        config THERMOMETER_SENSOR_BACKEND_REAL
            bool "Two DS18B20 sensors on GPIO14/GPIO27"
    endchoice

endmenu
