# Vite (repo root). Restart `npm run dev` after changing this file.
#
# mock  = in-browser simulator (default if this variable is unset)
# ble   = teammate Python connector on 127.0.0.1:8000 + optional MySQL reader
VITE_DATA_SOURCE=mock

# Optional. Must match ALERT_API_TOKEN in server/.env if that is set.
# VITE_ALERT_API_TOKEN=
