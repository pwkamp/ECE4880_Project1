{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ece4880.example/schemas/test-result-v1.json",
  "title": "Thermometer consolidated test result",
  "type": "object",
  "required": ["schema_version", "run_id", "test_id", "profile", "status", "evidence_credit", "started_at_utc", "ended_at_utc", "duration_seconds", "executor", "requirements", "lifecycle", "measurements", "assertions", "environment", "artifacts", "warnings", "failure"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 10},
    "test_id": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3}$"},
    "profile": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL", "ERROR", "BLOCKED", "SKIP", "MANUAL_REQUIRED", "TIMEOUT", "ABORTED", "INCOMPLETE"]},
    "evidence_credit": {"enum": ["FULL", "PARTIAL", "SUPPORTING_ONLY", "NONE"]},
    "started_at_utc": {"type": "string"},
    "ended_at_utc": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "executor": {"type": "object", "required": ["display_name", "identity"]},
    "requirements": {"type": "array", "minItems": 1},
    "lifecycle": {"type": "array", "minItems": 4},
    "measurements": {"type": "array"},
    "assertions": {"type": "array"},
    "environment": {"type": "object"},
    "artifacts": {"type": "array"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "failure": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
